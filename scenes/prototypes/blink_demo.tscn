[node name="HeadlightsBeat" type="Node3D" parent="Beats"]
script = ExtResource("6_beat")
lines = Array[String](["Headlights in the lane.", "Slowing at the bend.", "...Past it.", "Footsteps on the porch. Slow. Careful of the ice.", "\"...Hello? Is someone—\"", "\"...Oh.\"", "\"Oh, love. Look at you. You're—\"", "\"—safe.\""])
line_times = Array[float]([2.0, 5.5, 8.5, 11.0, 15.0, 19.0, 22.5, 28.0])
protect_time = 0.0
