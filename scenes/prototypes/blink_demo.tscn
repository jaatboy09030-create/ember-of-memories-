[node name="TruthBeat" type="Node3D" parent="Beats"]
script = ExtResource("6_beat")
lines = Array[String](["The study door. Same door.", "I closed my eyes. This time I'd stay for the end of it."])
line_times = Array[float]([1.0, 5.5])
protect_time = 8.0
max_wait = 70.0
saturation = 0.2
closed_eyes_sound = "argument_muffled"
closed_eyes_lines = Array[String](["\"He's seventeen—\"", "\"He's old enough to make his own mistakes, and I won't—\"", "\"Keep your voice down—\"", "\"If he wants to go, then go—\"", "\"—and I'll drive him. I'm not having him walk that lane in the snow.\"", "\"Then tell him. About St. Brigid's.\"", "\"Christmas. I want to see his face.\""])
wait_for_closed_lines = true
closed_lines_done_caption = "He was half a sentence away."

