[node name="WintersBeat" type="Node3D" parent="Beats"]
script = ExtResource("6_beat")
time_card = "What the postcards said."
protect_time = 2.0
wait_for_hotspot = false
saturation = 0.35
heavy_eyes_after = 6.0
montage_lines = Array[String](["First winter: \"Set your place at tea again. Your dad sat with it. He doesn't say much these days.\"", "Third winter: \"Your dad won't let me touch the porch light. Says you'll want it on.\"", "Fifth winter: \"Electric's gone up. He still won't let me touch the switch.\"", "Eighth winter: \"They asked again if I want his coat taken down. I said he'll want it there when he comes in.\"", "Tenth winter: \"Two cups in the morning. He lets his go cold. He always did.\"", "Twelfth winter: \"In for some tests. Back Thursday. I've told your dad to keep the fire in.\""])
montage_sound = "paper_pickup"
music = "theme_broken"

