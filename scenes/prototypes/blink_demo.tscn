[node name="LivingBeat" type="Node3D" parent="Beats"]
script = ExtResource("6_beat")
time_card = "The first winter I remember."
lines = Array[String](["Grandma knitted with her eyes shut. She said her hands could see.", "I'd lie on the rug and count the stitches until I couldn't."])
line_times = Array[float]([1.2, 6.5])
protect_time = 5.0
saturation = 0.3
closed_eyes_sound = "knit_loop"
closed_eyes_caption = "Click, click, click. I fell asleep to it every night that winter."
music = "theme_piano"

