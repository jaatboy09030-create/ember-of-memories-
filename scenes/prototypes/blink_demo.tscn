saturation = 1.0
heavy_eyes_after = 12.0
final_beat = true
auto_end_after = 32.0
ending_lines = Array[String](["I'm home, Mum.", "Dad's coat is still on the hook. We'll take it down together. Not tonight."])
ending_lines_if_blinked = Array[String](["I blinked.", "I never heard the end of it.", "But this time, I didn't leave."])

