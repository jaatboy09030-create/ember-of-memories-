[node name="ClippingText" type="Label3D" parent="Beats/PhotoBeat/Props/Clipping"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.002)
pixel_size = 0.00045
modulate = Color(0.08, 0.08, 0.08, 1)
outline_size = 0
text = "THE COURIER   Saturday 15 December

LOCAL MAN DIES AT FERROW BEND

The car of Tom Hale, 48, was found
in the ditch at Ferrow Bend on Friday
night. Mr Hale had gone out in the
snow to look for his son, 17, who
left home earlier that evening.
The boy has not been found."
font = SubResource("PrintFont")
font_size = 40
horizontal_alignment = 0

[node name="FireplaceBeat" type="Node3D" parent="Beats"]
script = ExtResource("6_beat")
lines = Array[String](["The fire was out. Nobody had kept it in.", "Her pill box on the mantel. Thursday, still full. Friday. Saturday.", "The light from the lane came in and settled by the grate. As if it had been coming here all along."])
